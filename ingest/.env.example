# 可以直接用伺服器安裝完印出的指令（加 --save 會自動寫進這裡），或手動填

# 暫存區：卡片先複製到這裡，處理完可用 --cleanup 刪掉
STAGING_DIR=~/SnapPipeStaging

# 伺服器與上傳 token
SERVER_URL=
UPLOAD_TOKEN=
UPLOAD_WORKERS=3

# 上傳後請伺服器排進分析佇列，由 worker 用 Meta AI 選片、評分、寫圖說（0 = 只上傳不分析；也可用 --no-analyze 單次關掉）
ANALYZE=1

# NAS 備份位置：smb://帳號@NAS位址/共用資料夾/子資料夾（留空則不備份）
# Mac：密碼放 ~/Library/Preferences/nsmb.conf 就不用每次輸入；Linux：先 mount -t cifs 掛好，這裡填掛載後的路徑
NAS_SMB=
# 共用資料夾沒被掛載時，自動掛到這裡（Mac）
NAS_MOUNT=~/mnt/SnapPipeNAS

# 伺服器也提供 RAW 下載（1=上傳 RAW，0=只傳 JPG；NAS 一律備份 RAW）
UPLOAD_RAW=1
