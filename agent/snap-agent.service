[Unit]
Description=SnapPipe snap-agent（相機旁的轉送器）
After=network-online.target
Wants=network-online.target

[Service]
User=snap
Group=snap
SupplementaryGroups=plugdev
WorkingDirectory=/opt/snap-agent
ExecStart=/opt/snap-agent/.venv/bin/python /opt/snap-agent/snap_agent.py -c /etc/snap-agent.toml run
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
# lgpio 要在可寫的資料夾建 FIFO（工作資料夾 /opt/snap-agent 對 snap 唯讀）
Environment=LG_WD=/var/lib/snap-agent

[Install]
WantedBy=multi-user.target
