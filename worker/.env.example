# SnapPipe worker（Meta AI 版）設定。複製成 .env（權限 600）
# Mac、Linux、伺服器本機都能跑；照片分析交給 Meta Model API，不需要 Mac 的 Vision

# 伺服器：安裝完印出的網址；多台返圖站用逗號分隔，同一個 worker 全部服務
# worker 和伺服器裝在同一台時填 http://127.0.0.1:8080
SERVER_URL=
# 區網直連不用 token（伺服器的 SNAPPIPE_WORKER_TOKEN 留空時）；只有伺服器設了 token（外面經 VPN 連回來）才填
WORKER_TOKEN=
# 管理指令（--status / --set-album / --live）預設用 worker 的身分；也可以填返圖站的上傳 token
ADMIN_TOKEN=
WORKER_NAME=
# 同時在手上的照片上限（湊組 + 分析中）、沒工作時幾秒問一次
CLAIM_MAX=16
POLL_SEC=2
# 下載下來的原圖與本機狀態
WORK_DIR=~/SnapPipeWorker

# 分析器：meta_ai（Meta Model API）、remote_http（POST 給任何 HTTP 服務）、none（不用 AI，當普通相簿）
# setup.sh 問金鑰時留空會自動設成 none
ANALYZER=meta_ai
# 分析器把 IPTC/XMP 寫進 JPG 後，是否把這份換上伺服器（下載的 JPG 就帶圖說、星等）
UPLOAD_TAGGED_JPG=1

# --- Meta Model API（https://dev.meta.ai）---
# 後台 Dashboard → API keys 建立。setup.sh 會問並驗證（./setup.sh --ask-key 換金鑰）；只放在這個檔，不要進 git
META_API_KEY=
# muse-spark-1.3（一般方案）。不要用 -contributor：那個方案 Meta 可以拿你的照片訓練模型
META_MODEL=muse-spark-1.3
META_API_BASE=https://api.meta.ai/v1
# 推理強度：minimal / low / medium / high；越高越慢越貴。選片與讀號碼用 low 就夠
META_REASONING=low
META_TIMEOUT=120
# 同時送出幾組連拍（API 每分鐘 3000 次，通常不是瓶頸；家裡上傳頻寬才是）
META_CONCURRENCY=4

# --- 連拍分組（階段一：整組一起比較）---
# 同一台相機、拍攝間隔 ≤ 這麼多秒算同一組
BURST_GAP_SEC=0.5
# 這麼多秒沒有新照片進來就當這組拍完，送出分析
BURST_IDLE_SEC=1.5
# 一組最多幾張（長連拍會切成多組先處理；API 一次最多 50 張圖）
BURST_MAX=40
# 送給模型的縮圖長邊（px）：階段一比較用 512，階段二讀號碼與寫圖說用 1536
BURST_THUMB_EDGE=512
CAPTION_EDGE=1536

# --- 階段二：球員與圖說 ---
# 0 = 只選片評分，不寫圖說（省錢）
CAPTION=1
# 每組連拍最多選幾張（1~3），只有選中的才寫圖說
MAX_PICKS=3
# 第二、三名精選的最低分（1–10）；整組都糊時只留第一名，也省下圖說的費用
PICK_MIN_SCORE=4
# 只替這個星等以上的精選寫圖說（圖說每張約是選片的 6 倍費用）；0 = 每張精選都寫
CAPTION_MIN_STARS=4
# 比賽資料與名單的資料夾（留空 = worker/games）
GAMES_DIR=
# 球員信心低於這個值要人工確認姓名
REVIEW_CONF=0.8
# 「依球員」分組：信心至少這麼多才放進該球員的相簿
PLAYER_GROUPS=1
PLAYER_MIN_CONF=0.7
PLAYER_MIN_PHOTOS=1

# --- 分數與星等 ---
# final = overall × w1 + peak × w2 + 銳利度 × w3 − 問題扣分（1~10）
SCORE_WEIGHTS=0.65,0.25,0.10
# final 到這些門檻分別是 2、3、4、5 星
STAR_THRESHOLDS=4,5.5,7,8.5
# 1 = 相機內評過的星等也用 AI 分數蓋掉
RATING_OVERWRITE=0
# 把圖說、星等、球員寫進 JPG 的 IPTC/XMP（需要 exiftool）
WRITE_IPTC=1

# --- NAS 備份：smb://帳號@NAS位址/共用資料夾/子資料夾（Mac 會自動掛載）
# Linux 請先 mount -t cifs 掛好，這裡填掛載後的路徑；留空則不備份 ---
NAS_SMB=
NAS_MOUNT=~/mnt/SnapPipeNAS
